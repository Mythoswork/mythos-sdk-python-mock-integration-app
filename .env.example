MYTHOS_API_URL=http://localhost:5001
CALCULATOR_BASE_URL=http://localhost:8001
TEST_USER_EMAIL=carol@example.com
TEST_USER_PASSWORD=Test@1234
# written by bootstrap.py, do not hand-edit
# MYTHOS_LISTING_ID=

# Server-only provider configuration; the Mythos SDK supplies the gateway URL and identity header.
PRODUCER_OPENAI_API_KEY=replace-with-provider-api-key
ALPHA_MODEL_ID=openai/gpt-4o-mini

# Encrypts the post-launch session (including the LLM identity token) into this app's own
# HttpOnly cookie via the SDK's encode_session()/decode_session() -- lets any number of this
# app's own routes share one launch/consume without re-touching Mythos. Use at least 32
# random characters; rotating it invalidates all currently-encoded session cookies.
MYTHOS_SESSION_SECRET=replace-with-a-long-random-local-secret
